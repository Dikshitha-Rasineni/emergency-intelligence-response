APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="RESQ.AI Emergency Intelligence & Response"

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resq_ai

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Local AI Engine (Ollama / Qwen2.5/Qwen3 / Llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Routing & Speed defaults (Urban Emergency Corridor km/h)
DEFAULT_ROUTING_SPEED_KMH=40.0

# Priority Engine Thresholds
PRIORITY_CRITICAL_THRESHOLD=75
PRIORITY_HIGH_THRESHOLD=50
PRIORITY_MODERATE_THRESHOLD=25

# ============================================================
# Amazon Location Service
# ============================================================
# AWS region where Location resources are deployed
AWS_REGION=us-east-1

# Amazon Location map resource name (created: resq-ai-maps)
AWS_LOCATION_MAP_NAME=resq-ai-maps

# Amazon Location route calculator name (created: resq-ai-routing)
AWS_LOCATION_ROUTE_CALCULATOR=resq-ai-routing

# AWS credentials — use IAM role in production; for local dev set via
# environment variables or ~/.aws/credentials. NEVER commit real keys.
# AWS_ACCESS_KEY_ID=<your-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
