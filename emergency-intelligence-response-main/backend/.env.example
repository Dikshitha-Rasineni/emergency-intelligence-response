APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="RESQ.AI Emergency Intelligence & Response"

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resq_ai

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Local AI Engine (Ollama / Qwen2.5/Qwen3 / Llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Routing & Speed defaults (Urban Emergency Corridor km/h)
DEFAULT_ROUTING_SPEED_KMH=40.0

# Priority Engine Thresholds
PRIORITY_CRITICAL_THRESHOLD=75
PRIORITY_HIGH_THRESHOLD=50
PRIORITY_MODERATE_THRESHOLD=25
