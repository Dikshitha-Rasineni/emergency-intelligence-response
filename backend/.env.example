# ---------------- Core ----------------
APP_ENV=development                 # development | test | production
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resq_ai   # PostgreSQL 14+ with PostGIS 3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
IOT_DEVICE_TOKEN=replace-with-device-secret    # same value in iot/include/secrets.h

# ---------------- Text LLM (pick ONE provider) ----------------
# The citizen never waits for the LLM: reports are assessed instantly by rules and refined in the background.
LLM_PROVIDER=ollama                 # ollama | gemini | openai | none
LLM_TIMEOUT_SECONDS=20

# Local, private (Ollama). think=false is sent automatically, which removes Qwen3's slow reasoning phase.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b               # faster on CPU: qwen3:1.7b or qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m

# Hosted, fastest without a GPU (citizen text leaves your machine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible server: Groq, OpenRouter, llama.cpp `llama-server`, vLLM, LM Studio
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.1-8b-instant

# ---------------- Vision model ----------------
VISION_PROVIDER=ollama              # ollama | gemini | openai | none
OLLAMA_VISION_MODEL=qwen2.5vl:3b    # `ollama pull qwen2.5vl:3b`
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=
VISION_TIMEOUT_SECONDS=60

# ---------------- Server speech-to-text (browser speech is tried first) ----------------
STT_PROVIDER=none                   # gemini | openai | none   (openai = Whisper-compatible endpoint, e.g. Groq)
OPENAI_STT_MODEL=whisper-large-v3

# ---------------- Uploads & retention ----------------
MAX_IMAGE_MB=8
MAX_IMAGES_PER_INCIDENT=6
MEDIA_RETENTION_DAYS=30

# ---------------- Geo ----------------
OSRM_BASE_URL=https://router.project-osrm.org   # public demo server; self-host for production
ENABLE_OSM_LIVE_LOOKUP=true
IOT_MERGE_RADIUS_M=300
IOT_MERGE_WINDOW_MIN=20
# Optional Amazon Location (leave blank to skip). Credentials via IAM role / ~/.aws, never in this file.
AWS_REGION=us-east-1
AWS_LOCATION_MAP_NAME=
AWS_LOCATION_ROUTE_CALCULATOR=

# ---------------- Policy knobs ----------------
PRIORITY_CRITICAL_THRESHOLD=75
PRIORITY_HIGH_THRESHOLD=50
PRIORITY_MODERATE_THRESHOLD=25
ACK_DEADLINE_CRITICAL_MIN=2
ACK_DEADLINE_DEFAULT_MIN=5
RATE_LIMIT_REPORTS_PER_MIN=10
RATE_LIMIT_UPLOADS_PER_MIN=30

# GenAI speed: optional smaller model for briefs / Ask RESQ (e.g. qwen3:1.7b); context window for Ollama
GENAI_FAST_MODEL=
OLLAMA_NUM_CTX=4096
